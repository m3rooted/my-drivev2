{$DOMAIN} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy backend:5000 {
			flush_interval -1
		}
	}

	handle {
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob: data:"
		}
		root * /srv
		try_files {path} {path}/ /index.html
		file_server
	}
}
